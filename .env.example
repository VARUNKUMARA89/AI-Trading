# Copy this file to .env and fill in what you use. Never share your .env.

# Claude (brain = "claude-api")
ANTHROPIC_API_KEY=

# Upstox market data (feed = "upstox"). Create an app at https://account.upstox.com/developer/apps
# Use redirect URL http://127.0.0.1:5055/callback, then run: python -m arena upstox-login
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:5055/callback
UPSTOX_ACCESS_TOKEN=
